# Fukidashi server configuration.
# Copy to server/.env (start.sh / start.bat do this for you) and restart the
# server after editing. API keys live ONLY here, never in the extension.
# Leave a value empty to disable that feature.

# ---------------------------------------------------------------------------
# Context mode (LLM): translates the whole page at once, with a running story
# summary and a character-name glossary kept per series.
# If no LLM is configured (or it fails), pages fall back to fast mode and the
# extension shows a note saying so.
# ---------------------------------------------------------------------------

# anthropic (default) | openai | ollama | lmstudio | openrouter | none
#   ollama / lmstudio / openrouter are all "OpenAI-compatible": set OPENAI_BASE_URL.
LLM_PROVIDER=anthropic

# Model name. Empty = provider default (anthropic: claude-haiku-5-5, openai: gpt-4o-mini).
# Required for ollama / lmstudio / openrouter.
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Base URL for OpenAI-compatible servers (leave empty for api.openai.com).
OPENAI_BASE_URL=

# Seconds to wait for an LLM reply (local models on CPU can be slow).
LLM_TIMEOUT=120

# --- Example: local Ollama (free, private; `ollama pull qwen2.5:14b` first) ---
# LLM_PROVIDER=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b
#
# --- Example: LM Studio (start its local server first) ---
# LLM_PROVIDER=lmstudio
# OPENAI_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=<the model identifier shown in LM Studio>
#
# --- Example: OpenRouter ---
# LLM_PROVIDER=openrouter
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# LLM_MODEL=<provider/model>
#
# --- Example: OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Fast mode (no LLM): each text block translated on its own. Engine "auto"
# uses DeepL if a key is set, else Google, else the offline engine.
# ---------------------------------------------------------------------------

# DeepL API key. Free keys end in ":fx" and use the free endpoint automatically.
DEEPL_API_KEY=
# Google Cloud Translation (v2 / Basic) API key.
GOOGLE_API_KEY=
# The offline engine (Argos Translate) needs no key: it downloads language
# packages on first use and pivots through English when needed.

# ---------------------------------------------------------------------------
# Image processing
# ---------------------------------------------------------------------------

# auto | true | false. "auto" uses an NVIDIA GPU (CUDA) when PyTorch can see one.
USE_GPU=auto

# lama | opencv. LaMa (big-lama.pt, ~200 MB, downloaded to server/models/ on
# first use) gives much cleaner results when text sits on artwork; OpenCV is
# the lightweight fallback. Speech bubbles are filled directly either way.
INPAINTER=lama

# true | false. manga-ocr reads Japanese far better than EasyOCR (~450 MB model).
USE_MANGA_OCR=true

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

HOST=127.0.0.1
PORT=5003

# Translated pages are cached on disk (server/data/cache) up to this size.
# 0 disables the cache.
CACHE_MAX_MB=1024

# Advanced:
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# LAMA_URL=<alternative download URL for big-lama.pt>
# FUKIDASHI_DATA_DIR=<where cache and story memory are stored; default server/data>
